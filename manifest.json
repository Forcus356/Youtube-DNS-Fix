{
  "manifest_version": 3,
  "name": "YouTube Фикс",
  "version": "1.5",
  "description": "Фикс YouTube для браузеров через локальный SOCKS5 прокси",
  "permissions": ["proxy", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Фикс"
  }
}